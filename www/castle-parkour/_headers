# HTML：可协商缓存（304），有更新再换；勿永久 no-store
/index.html
  Cache-Control: max-age=0, must-revalidate

/build-id.txt
  Cache-Control: max-age=0, must-revalidate

/
  Cache-Control: max-age=0, must-revalidate

# 带 ?v= 的静态资源长缓存；版本号不变则直接命中，无需强刷
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=86400
